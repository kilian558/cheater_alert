# ==============================================
# Discord Bot Configuration
# ==============================================
DISCORD_TOKEN=your_discord_bot_token_here
DISCORD_CLIENT_ID=your_discord_client_id_here
DISCORD_GUILD_ID=your_guild_id_here
DISCORD_CHANNEL_ID=your_channel_id_for_reports

# ==============================================
# CRCON API Settings
# ==============================================
# Beispiel: https://gbg-hll.com:64301

# Hell Let Loose Server 1
SERVER1_NAME=Server 1
SERVER1_API_URL=https://your-crcon-url:64301
SERVER1_API_TOKEN=your_api_token_here

# Hell Let Loose Server 2 (Optional)
SERVER2_NAME=Server 2
SERVER2_API_URL=https://your-crcon-url:64302
SERVER2_API_TOKEN=your_api_token_here

# Hell Let Loose Server 3 (Optional)
SERVER3_NAME=Server 3
SERVER3_API_URL=https://your-crcon-url:64303
SERVER3_API_TOKEN=your_api_token_here

# ==============================================
# Detection Settings (Wichtigste Einstellungen)
# ==============================================

# KPM Schwellenwert für Cheater-Verdacht (Session KPM)
# Spieler mit Session KPM >= diesem Wert werden als verdächtig eingestuft
# Empfohlen: 1.25 (für ganzes Match)
OVERALL_KPM_THRESHOLD=1.25

# Rolling KPM Schwellenwert (letzte 5 Minuten)
# Spieler mit Rolling KPM >= diesem Wert werden als verdächtig eingestuft
# Empfohlen: 3.0 (für kurze Killstreaks)
ROLLING_KPM_THRESHOLD=3.0

# Maximales Level das überwacht werden soll
# Spieler über diesem Level werden ignoriert
# 0 = Level-Check deaktiviert (alle Level werden geprüft)
MAX_LEVEL_TO_TRACK=100

# Minimale Spielzeit/Kills bevor Alert ausgelöst wird
# WICHTIG: Spielzeit resettet bei jedem Reconnect (aktuelle Session)
# Verhindert false positives bei zu wenig Daten
MIN_PLAYTIME_MINUTES=15
MIN_KILLS_TO_TRIGGER=25

# Check Interval in Sekunden (wie oft werden Server geprüft)
# Empfohlen: 30-60 Sekunden
CHECK_INTERVAL=30

# ==============================================
# Blacklist Configuration
# ==============================================
# CRCON Blacklist ID (Standard: 1)
# Blacklists funktionieren serverübergreifend!
BLACKLIST_ID=1

# ==============================================
# Erweiterte Optionen (Optional - haben sinnvolle Defaults)
# ==============================================

# Level-Check aktivieren/deaktivieren
# Bei false wird MAX_LEVEL_TO_TRACK ignoriert
# ENABLE_LEVEL_CHECK=true

# Cache-Dauer für Level-Daten (in Minuten)
# LEVEL_CACHE_DURATION_MINUTES=30

# Tank/Artillerie-Rollen ausschließen (Standard: aktiv)
# Diese Spieler haben natürlich höhere KPM durch ihre Rolle
# WICHTIG: Geschütze (155MM HOWITZER) können von JEDEM Spieler bedient werden
# (Infantry benutzt verlassene Tanks/Geschütze) - diese werden NICHT gefiltert!
# 
# Gefilterte Rollen (uses .includes() - partial match):
# - tankcommander, crewman: Tank-Besatzung
# - spotter: Recon Spotter  
# - artillery: Artillery Squad (artilleryobserver, artilleryofficer, etc.)
# 
# EXCLUDE_TANK_ROLES=true
# EXCLUDE_ARTILLERY_ROLES=true
# EXCLUDED_ROLES=tankcommander,crewman,spotter,artillery

# Cache-Dauer für Rollen-Check (in Sekunden)
# ROLE_CACHE_DURATION_SECONDS=25

# KPM Schwellenwert ohne Fahrzeuge (aktuell nicht implementiert)
# SUSPICIOUS_KPM_NO_VEHICLES=2.0
