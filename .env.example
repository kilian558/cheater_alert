# Discord Bot Configuration
DISCORD_TOKEN=your_discord_bot_token_here
DISCORD_CLIENT_ID=your_discord_client_id_here
DISCORD_GUILD_ID=your_guild_id_here
DISCORD_CHANNEL_ID=your_channel_id_for_reports

# CRCON API Settings (REST API statt traditionellem RCON)
# Beispiel: https://gbg-hll.com:64301

# Hell Let Loose Server 1 (CRCON)
SERVER1_NAME=Server 1
SERVER1_API_URL=https://your-crcon-url:64301
SERVER1_API_TOKEN=your_api_token_here

# Hell Let Loose Server 2 (CRCON)
SERVER2_NAME=Server 2
SERVER2_API_URL=https://your-crcon-url:64302
SERVER2_API_TOKEN=your_api_token_here

# Hell Let Loose Server 3 (CRCON)
SERVER3_NAME=Server 3
SERVER3_API_URL=https://your-crcon-url:64303
SERVER3_API_TOKEN=your_api_token_here

# Detection Settings
MAX_LEVEL_TO_TRACK=100
MIN_KILLS_TO_TRIGGER=25
MIN_PLAYTIME_MINUTES=15
SUSPICIOUS_KPM_THRESHOLD=2.5
SUSPICIOUS_KPM_NO_VEHICLES=2.0

# Check Interval (in seconds)
CHECK_INTERVAL=30

# Blacklist Configuration
# Die Blacklist ID aus CRCON (Standard: 1 für Default Blacklist)
# Blacklists sind serverübergreifend!
BLACKLIST_ID=1
