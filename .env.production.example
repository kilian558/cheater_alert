# ==============================================
# HLL Anti-Cheat Monitor - Production Config
# ==============================================

# Discord Bot Configuration
DISCORD_TOKEN=your_discord_bot_token_here
DISCORD_CLIENT_ID=your_discord_client_id_here
DISCORD_GUILD_ID=your_guild_id_here
DISCORD_CHANNEL_ID=your_channel_id_for_reports

# ==============================================
# CRCON API Configuration
# ==============================================
# Beispiel mit den gbg-hll.com Servern
# Passe die URLs und Credentials an deine Server an

# Hell Let Loose Server 1 (CRCON API)
SERVER1_NAME=German Battleground 1
SERVER1_API_URL=https://gbg-hll.com:64301
SERVER1_API_TOKEN=your_crcon_api_token

# Hell Let Loose Server 2 (CRCON API)
SERVER2_NAME=German Battleground 2
SERVER2_API_URL=https://gbg-hll.com:64302
SERVER2_API_TOKEN=your_crcon_api_token

# Hell Let Loose Server 3 (CRCON API)
SERVER3_NAME=German Battleground 3
SERVER3_API_URL=https://gbg-hll.com:64303
SERVER3_API_TOKEN=your_crcon_api_token

# ==============================================
# Detection Settings
# ==============================================

# Session KPM Schwellenwert für verdächtiges Verhalten (ganzes Match)
# Spieler mit Session KPM >= diesem Wert werden als verdächtig eingestuft
# Session KPM = Kills in diesem Match / Spielzeit in diesem Match
# Empfohlen: 1.25 - 1.5 (abhängig von deiner Community)
# Höhere Werte = weniger False Positives, aber auch später erkannt
OVERALL_KPM_THRESHOLD=1.25

# Rolling KPM Schwellenwert (letzte 5 Minuten)
# Spieler mit Rolling KPM >= diesem Wert werden als verdächtig eingestuft
# Rolling KPM = Kills in letzten 5 min / 5 Minuten
# Empfohlen: 3.0 - 4.0 (für Killstreaks)
# Höhere Werte = nur extreme Killstreaks werden erkannt
ROLLING_KPM_THRESHOLD=3.0

# Maximales Level das überwacht werden soll
# Spieler über diesem Level werden ignoriert
# 0 = deaktiviert (alle Level werden geprüft)
# Empfohlen: 100-150 (erfahrene Spieler haben oft hohe KPM)
MAX_LEVEL_TO_TRACK=100

# Minimale Spielzeit in Minuten bevor ein Alert ausgelöst wird
# WICHTIG: Spielzeit resettet bei jedem Reconnect (nur aktuelle Session)
# Spieler müssen mindestens diese Zeit gespielt haben ODER MIN_KILLS_TO_TRIGGER erreichen
# Verhindert false positives bei zu wenig Daten
MIN_PLAYTIME_MINUTES=15

# Minimale Anzahl Kills bevor ein Alert ausgelöst wird
# Alternative zu MIN_PLAYTIME_MINUTES (wenn Spieler sehr aktiv ist)
MIN_KILLS_TO_TRIGGER=25

# ==============================================
# Performance Settings
# ==============================================

# Intervall in Sekunden zwischen den Server-Checks
# Niedrigere Werte = mehr Last auf API, aber schnellere Erkennung
# Empfohlen: 30-60 Sekunden
CHECK_INTERVAL=30

# ==============================================
# Blacklist Configuration
# ==============================================

# CRCON Blacklist ID (Standard: 1 für Default Blacklist)
# Blacklists funktionieren serverübergreifend!
# Alle Server die zur selben Blacklist gehören 
# bannen den Spieler automatisch
# 
# Wie finde ich meine Blacklist ID?
# 1. Öffne CRCON Web Interface
# 2. Gehe zu Settings → Blacklists
# 3. Die ID steht in der Liste
BLACKLIST_ID=1

# ==============================================
# Erweiterte Einstellungen (Optional - haben sinnvolle Defaults)
# ==============================================
# Diese Einstellungen sind bereits aktiviert und haben vernünftige Standardwerte.
# Tank- und Artillerie-Rollen werden standardmäßig ausgefiltert.
# Du musst diese nur anpassen, wenn du andere Werte möchtest.

# Level-Check aktivieren (erfordert zusätzliche API-Calls)
# Bei false wird MAX_LEVEL_TO_TRACK ignoriert
# Standard: true (mit Cache reduziert sich die API-Last)
# ENABLE_LEVEL_CHECK=true

# Cache-Dauer für Level-Daten in Minuten
# Spieler-Level ändern sich selten, daher ist ein langer Cache sinnvoll
# Standard: 30 Minuten
# LEVEL_CACHE_DURATION_MINUTES=30

# Spieler mit Tank-Rollen ausschließen (tankcommander, crewman)
# Tank-Spieler haben häufig höhere KPM durch Fahrzeug-Kills
# Standard: true (bereits aktiv)
# EXCLUDE_TANK_ROLES=true

# Spieler mit Artillerie-Rollen ausschließen (spotter)
# Spotter können hohe KPM durch indirekte Kills (Spotting) haben
# WICHTIG: Artillerie-Geschütze (155MM HOWITZER) können von JEDER Infantry-Rolle
# bedient werden und sind daher NICHT über Rollen filterbar!
# Diese Einstellung bezieht sich nur auf "Spotter" (Recon-Einheit)
# Standard: true (bereits aktiv)
# EXCLUDE_ARTILLERY_ROLES=true

# Komma-getrennte Liste von Rollen die ausgeschlossen werden sollen
# Die Prüfung ist case-insensitive und prüft mit "contains"
# Standard: tankcommander,crewman,spotter (bereits aktiv)
# EXCLUDED_ROLES=tankcommander,crewman,spotter

# Cache-Dauer für Team View Daten in Sekunden
# Team View wird für Rollen-Check benötigt
# Sollte kürzer als CHECK_INTERVAL sein
# Standard: 25 Sekunden (bei CHECK_INTERVAL=30)
# ROLE_CACHE_DURATION_SECONDS=25

# KPM Schwellenwert ohne Fahrzeuge/Artillerie
# (Aktuell nicht implementiert, für zukünftige Features)
# SUSPICIOUS_KPM_NO_VEHICLES=2.0

# ==============================================
# HINWEISE
# ==============================================
#
# CRCON API Permissions:
# Dein CRCON User braucht mindestens diese Permissions:
# - api.can_view_get_players
# - api.can_view_live_scoreboard
# - api.can_view_gamestate
# - api.can_perma_ban_players
# - api.can_temp_ban_players
#
# Self-Signed Certificates:
# SSL-Zertifikatsfehler werden automatisch ignoriert
# Das ist normal für selbst-signierte CRCON Installationen
#
# Discord Bot Permissions:
# - Send Messages
# - Embed Links
# - Read Message History
#
